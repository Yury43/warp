#!/usr/bin/env python3
"""Build the static Linux executables embedded by persistent_ssh_sessions."""

import os
import shutil
import struct
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def verify_static_elf(data, machine):
    if data[:6] != b"\x7fELF\x02\x01" or struct.unpack_from("<H", data, 18)[0] != machine:
        raise ValueError(
            "Helper must be a little-endian ELF64 binary for the requested architecture"
        )
    start = struct.unpack_from("<Q", data, 32)[0]
    size, count = struct.unpack_from("<HH", data, 54)
    for index in range(count):
        header = start + index * size
        kind = struct.unpack_from("<I", data, header)[0]
        if kind == 3:
            raise ValueError("Helper requires a dynamic loader")
        if kind == 2:
            offset = struct.unpack_from("<Q", data, header + 8)[0]
            length = struct.unpack_from("<Q", data, header + 32)[0]
            for entry in range(offset, offset + length, 16):
                if struct.unpack_from("<Q", data, entry)[0] == 1:
                    raise ValueError("Helper requires shared libraries")


def main():
    if not shutil.which("cargo-zigbuild"):
        raise SystemExit(
            "Install cargo-zigbuild and Zig first; see app/tests/ssh/PERSISTENT_SESSIONS.md"
        )
    target_directory = ROOT / "target" / "ssh-helper-build"
    destination = Path(
        os.environ.get("WARP_SSH_HELPER_DIR", ROOT / "target/persistent-ssh-helpers")
    )
    destination.mkdir(parents=True, exist_ok=True)
    for architecture, machine in (("x86_64", 62), ("aarch64", 183)):
        target = architecture + "-unknown-linux-musl"
        subprocess.run(
            [
                "cargo",
                "zigbuild",
                "--locked",
                "--release",
                "-p",
                "warp_ssh_helper",
                "--target",
                target,
                "--target-dir",
                str(target_directory),
            ],
            cwd=ROOT,
            check=True,
            env={
                **os.environ,
                "CARGO_PROFILE_RELEASE_DEBUG": "0",
                "CARGO_PROFILE_RELEASE_STRIP": "symbols",
            },
        )
        source = target_directory / target / "release/warp_ssh_helper"
        verify_static_elf(source.read_bytes(), machine)
        output = destination / ("warp-ssh-helper-" + architecture)
        shutil.copyfile(source, output)
        output.chmod(0o700)
        print(f"Built static helper: {output}", flush=True)


if __name__ == "__main__":
    main()
